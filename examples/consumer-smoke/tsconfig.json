{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "exactOptionalPropertyTypes": true, "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "noUncheckedSideEffectImports": true,
    "skipLibCheck": false, "noEmit": true, "types": ["vite/client"]
  },
  "include": ["*.tsx", "public-types.ts"]
}
