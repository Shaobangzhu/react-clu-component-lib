{
  "name": "react-clu-component-lib",
  "version": "0.1.0",
  "private": true,
  "description": "CLU React 19 display, form, data and overlay primitives with scoped semantic themes.",
  "type": "module",
  "engines": {
    "node": ">=22.23.4",
    "npm": ">=10.9.0"
  },
  "packageManager": "npm@10.9.0",
  "files": [
    "dist/**/*.d.ts",
    "dist/index.js",
    "dist/styles.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "./dist/styles.css"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build && node scripts/build-types.mjs",
    "storybook": "storybook dev -p 6006 --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "quality:check": "npm run lint && npm run typecheck && npm test && npm run build && npm run build-storybook && npm run package:verify",
    "prepack": "npm run build",
    "package:verify": "npm run build && node scripts/verify-package.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@storybook/react-vite": "10.3.6",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.5",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shaobangzhu/react-clu-component-lib.git"
  }
}
